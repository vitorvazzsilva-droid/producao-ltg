{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "producao-ltg",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // O D1 mora no leste dos EUA (ENAM). Rodar o Worker do lado dele faz cada
  // consulta levar ~1ms em vez de ~120ms (ida e volta Sao Paulo <-> EUA).
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "producao-ltg-db",
      "database_id": "ee0f51e5-9488-4078-89e4-28400c08e263"
    }
  ]
}
